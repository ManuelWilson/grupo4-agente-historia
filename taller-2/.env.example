# ============================================================
# .env.example — copiar a .env y reemplazar los valores.
# NUNCA subir .env al repositorio, al ZIP ni a capturas.
# ============================================================

# ---------- Modelo (Google AI Studio) ----------
GOOGLE_API_KEY=replace-me
MODELO=gemini-3.5-flash-lite

# ---------- Telegram ----------
# Token ficticio: el real se obtiene en @BotFather y no se documenta.
TELEGRAM_TOKEN=123456789:replace-me
# Bot de PRUEBA para long polling local (`deploy/scripts/local_bot.py`).
# Debe ser un bot distinto: getUpdates borra el webhook del bot de produccion.
TELEGRAM_TOKEN_LOCAL=123456789:replace-me-local
# Secreto del webhook: generar con `python -c "import secrets; print(secrets.token_hex(32))"`.
TELEGRAM_SECRET=replace-with-random-64-hex
# Control de acceso del canal: IDs de chat/usuarios autorizados (separados por coma).
# Si queda vacio, el gateway debe fallar cerrado salvo TELEGRAM_ALLOW_ALL=true.
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOW_ALL=false
# false = dry-run: no se envia nada a Telegram (queda en el log). Para pruebas sin bot.
TELEGRAM_SEND_ENABLED=true

# ---------- Limites de uso y costo ----------
# Caracteres maximos por consulta.
MAX_INPUT_CHARS=2000
# Limite por chat/usuario, en memoria del proceso. 0 desactiva ese limite.
RATE_LIMIT_PER_MINUTE=6
RATE_LIMIT_PER_DAY=100
# Tokens maximos de salida del modelo (lo leen los agentes, no el gateway).
MAX_OUTPUT_TOKENS=1024

# ---------- Agentes A2A ----------
# En local se levantaron con langgraph dev en los puertos 2025 y 2026.
A2A_HISTORIA_URL=http://127.0.0.1:2025
A2A_GEOGRAFIA_URL=http://127.0.0.1:2026
A2A_HISTORIA_GRAPH=agente_profesor_historia
A2A_GEOGRAFIA_GRAPH=agente_profesor_geografia
# En local se pueden dejar vacios y descubrir con POST /assistants/search.
# En Heroku cambian si se recrea la app: verificar con scripts/discover_assistants.py.
A2A_HISTORIA_ASSISTANT_ID=
A2A_GEOGRAFIA_ASSISTANT_ID=
A2A_TIMEOUT_SECONDS=45
# Token compartido gateway <-> agentes. El gateway lo envía como
# `Authorization: Bearer ...` y cada agente lo exige en `/a2a/*`.
# Vacío = sin auth (solo aceptable en local). En la nube debe ser el mismo en los tres.
A2A_SHARED_TOKEN=

# ---------- Gateway local ----------
LOCAL_API_TOKEN=replace-me
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# ---------- Despliegue en la nube (opcional, +1) ----------
# Completar solo si se va a desplegar. No son necesarias para la entrega local.
PUBLIC_URL=https://replace-me.lambda-url.us-east-1.on.aws
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=replace-me
HEROKU_API_KEY=replace-me
HEROKU_APP_GATEWAY=replace-me
HEROKU_APP_HISTORIA=replace-me
HEROKU_APP_GEOGRAFIA=replace-me
