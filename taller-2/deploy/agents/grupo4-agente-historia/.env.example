# Copiar a .env y reemplazar. Nunca subir el .env real.
GOOGLE_API_KEY=replace-me
MODELO=gemini-3.5-flash-lite
# Agente profesor de historia expuesto por `langgraph dev` (lo usan los tests y consumidores).
# El assistant_id es un UUID que el servidor asigna al grafo: se obtiene con POST /assistants/search {"graph_id": ...}
A2A_HISTORIA_URL=http://127.0.0.1:2025
A2A_HISTORIA_GRAPH=agente_profesor_historia
# URL que el middleware publica dentro de la Agent Card.
# En local es la misma base del servidor; en Heroku, la URL publica de la app.
PUBLIC_BASE_URL=http://127.0.0.1:2025
# Token que exige este agente en /a2a/* (debe coincidir con el gateway).
# Vacío = sin auth (solo local).
A2A_SHARED_TOKEN=
